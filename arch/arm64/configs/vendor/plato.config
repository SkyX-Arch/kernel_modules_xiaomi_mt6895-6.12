# plato (Xiaomi 12T, MT6895) defconfig fragment for the 6.12 kernel.
#
# Derived from the 5.10 plato.config, re-mapped onto the 6.12 tree's own
# CONFIG symbols. Merge it together with the base:
#   scripts/kconfig/merge_config.sh -m .config \
#       arch/arm64/configs/mgk_64_k612_defconfig \
#       arch/arm64/configs/vendor/plato.config
#
# Symbols that only exist in the 5.10 vendor tree (MTK_FINGERPRINT_SUPPORT,
# TOUCHSCREEN_GOODIX_BRL_9916, MI_THERMAL_MULTI_CHARGE, MTK VOW personality
# knobs) are deliberately absent: their consumers were not ported, so setting
# them would just produce "unmet direct dependencies" warnings.

# ---- Camera ---------------------------------------------------------------
CONFIG_CUSTOM_KERNEL_IMGSENSOR="platos5khm6_mipi_raw platoimx596_mipi_raw platogc02m1_mipi_raw platos5k4h7_mipi_raw"
CONFIG_MTK_VIDEO_KTD2687=m

# ---- Charging -------------------------------------------------------------
# plato uses a 5000 mAh pack with the bq27z561 gauge and a sc8561 (4:1) /
# ln8410 charge pump pair; it has no MT6375 gauge and no PE+ buck charger.
# CONFIG_GAUGE_MT6375 is not set
# The plato DTS uses bq27z561 (gauge_chip = <1>) and the xm_charge PD stack
# links against bms_get_property() from the TI gauge driver.
CONFIG_XMEXT_TI_GAUGE=m
CONFIG_XM_PD_MANAGER=m
# Xiaomi async shrink-slab daemon (kshrink_lruvecd needs GKI mm hooks that
# this kernel does not export, so it stays off)
CONFIG_KSHRINK_SLABD=m
# Xiaomi thermal HAL bridge
CONFIG_MI_THERMAL_INTERFACE=m
# NXP NFC (i2c) + P73 secure element (spi)
CONFIG_NFC_NXP_I2C=m
CONFIG_NXP_P73_DEVICES=m
CONFIG_REGULATOR_WL2866D=m
CONFIG_REGULATOR_WL2868C=m
CONFIG_REGULATOR_FAN53870=m

# ---- CPU/Memory latency manager -------------------------------------------
# mt6895's CM_MGR tables live in cm_mgr_legacy_v1/ in the 6.12 tree (cm_mgr/
# has no mtk_cm_mgr_mt6895.c), so the legacy-v1 driver has to be enabled.
CONFIG_MTK_CM_MGR_LEGACY_V1=m
CONFIG_MTK_CM_MGR_MT6895=m

# ---- Display --------------------------------------------------------------
# L12A CSOT (42-02-0a) and L12A Tianma (36-02-0b), both 1220x2712 DSC cmd mode.
CONFIG_DRM_PANEL_L12A_42_02_0A_DSC_CMD=m
CONFIG_DRM_PANEL_L12A_36_02_0B_DSC_CMD=m
CONFIG_MI_DISP=y
CONFIG_MI_DISP_DSC2712=y
CONFIG_MI_DISP_ESD_CHECK=y
CONFIG_MI_DISP_SILKY_BRIGHTNESS_CRC=y
# L12A panels implement doze/LHBM in the panel driver itself.
CONFIG_MI_DISP_LHBM=y
CONFIG_MI_DISP_DOZE_SUSPEND=y

# ---- Fingerprint (Goodix GF3626ZS9 in TEE mode) ---------------------------
CONFIG_GOODIX_FINGERPRINT=m
# plato uses the TEE (gf_spi_tee) driver, not the CA "cap" variant.
# CONFIG_GOODIX_CAP_FINGERPRINT is not set

# ---- Touchscreen (FocalTech FTS L12A on SPI2) -----------------------------
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI_L12A=m
# double_click.ko (5.10 plato.config line 35); provides the
# tp_enable_doubleclick knob the touch feature HAL reads.
CONFIG_TOUCHSCREEN_NVT36672C_DOUBLE_CLICK=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# ---- Haptics (Awinic AW8697) ----------------------------------------------
CONFIG_INPUT_AW8697_HAPTIC=m

# ---- Sound ----------------------------------------------------------------
# plato pairs two CS35L41 amplifiers; the vendor fork is required for the
# cirrus,gpio-config2 / spk-sw-gpio properties in the plato DTS.
CONFIG_SND_SOC_CS35L41_PLATO=m
CONFIG_USB_SWITCH_ET7480=m

# ---- TEE ------------------------------------------------------------------
CONFIG_TRUSTONIC_TRUSTED_UI=m

# ---- Product --------------------------------------------------------------
CONFIG_BUILD_PRODUCT_NAME="plato"
CONFIG_TARGET_PRODUCT_PLATO=y
# CONFIG_TARGET_PRODUCT_XAGA is not set

# ---- Misc -----------------------------------------------------------------
CONFIG_MI_HARDWARE_ID=m
CONFIG_SIMTRAY_STATUS=m
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

# devtmpfs: the kernel auto-creates /dev/block nodes before userspace runs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- Module signing --------------------------------------------------------
# The base mgk_64_k612_defconfig sets
#   CONFIG_MODULE_SIG_KEY="$(DEVICE_MODULES_REL_DIR)/certs/mtk_signing_key.pem"
# which only expands in the Kleaf/bazel path. In the classic make path it
# becomes the literal "/certs/mtk_signing_key.pem" and the build dies with
# "no rule to make target". The 5.10 plato build shipped unsigned modules
# too, so drop signing instead of hardcoding an absolute path.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set

# ---- GPU -----------------------------------------------------------------
# 5.10 set CONFIG_MALI_BASE_MODULES=y (xiaomi_mt6895.config:150); it builds
# the mali_mgm / mali_prot_alloc helpers listed in modules.load.
CONFIG_MALI_BASE_MODULES=y

# USB Type-C / PD. 5.10 carried these in vendor/xiaomi_mt6895.config:63-64;
# the 6.12 fragment that does carry them (mgk_64_k612.config) is merged before
# plato.config, and TCPC_CLASS lost the merge - without it drivers/power/
# xm_charge/xmc_adapter.c fails on the undeclared tcpm_dpm_send_custom_vdm
# and tcpc_class.ko is not built at all.
CONFIG_TCPC_CLASS=m
CONFIG_USB_POWER_DELIVERY=m
CONFIG_MTK_USB_TYPEC=m

# ---------------------------------------------------------------------------
# Platform driver set, restored verbatim from the 5.10
# vendor/xiaomi_mt6895.config. mkg_64_k612.config only carries the generic MTK
# platform selection; these 252 symbols are the mt6895-specific ones plato
# actually runs with, and every one of them is declared in the 6.12 tree's own
# Kconfig - they were simply never enabled here, so the modules behind them
# were not built (MTK_SLBC, MTK_CMDQ_MBOX_EXT, the common clocks, the camera
# ISP chain, USB Type-C/PD, the sensor/IPI stack, ...).
