CONFIG_COMMON_CLK_MT6895_VCODEC=m
CONFIG_COMMON_CLK_MTK_FREQ_HOPPING=m
CONFIG_DEVAPC_MT6895=m
# CONFIG_DMABUF_HEAPS_SYSTEM is not set
# CONFIG_DRM_MEDIATEK is not set
CONFIG_DRM_MEDIATEK_PANEL=m
CONFIG_EXTCON_MTK_USB=m
# CONFIG_I2C_MT65XX is not set
CONFIG_INPUT_AW8697_HAPTIC=m
CONFIG_INTERCONNECT_MTK_EMI=m
CONFIG_INTERCONNECT_MTK_MMQOS_MT6895=m
CONFIG_KEYBOARD_MTK_KPD=m
