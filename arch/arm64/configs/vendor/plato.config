# ---------------------------------------------------------------------------
# Symbols the 6.12 tree renamed to DEVICE_MODULES_*. The 5.10 names above are
# dead in this tree: the Kconfig declares DEVICE_MODULES_<name> instead, so a
# plain CONFIG_<name>=m is silently dropped and the driver never gets built
# (CONFIG_MTK_IOMMU is the one that hurts most - without it every IS_ENABLED()
# block in include/soc/mediatek/smi.h and drivers/iommu/mtk_iommu.h falls to
# its inline-stub branch and the real prototypes collide).
CONFIG_DEVICE_MODULES_DMABUF_HEAPS_SYSTEM=m   # 5.10: CONFIG_DMABUF_HEAPS_SYSTEM=m
CONFIG_DEVICE_MODULES_SCSI_UFS_MEDIATEK=m   # 5.10: CONFIG_SCSI_UFS_MEDIATEK=m
CONFIG_DEVICE_MODULES_KEYBOARD_MTK_PMIC=m   # 5.10: CONFIG_KEYBOARD_MTK_PMIC=m
CONFIG_DEVICE_MODULES_SERIAL_8250_MT6577=m   # 5.10: CONFIG_SERIAL_8250_MT6577=m
CONFIG_DEVICE_MODULES_I2C_MT65XX=m   # 5.10: CONFIG_I2C_MT65XX=m
CONFIG_DEVICE_MODULES_SPI_MT65XX=m   # 5.10: CONFIG_SPI_MT65XX=m
CONFIG_DEVICE_MODULES_SPMI_MTK_PMIF=m   # 5.10: CONFIG_SPMI_MTK_PMIF=m
CONFIG_DEVICE_MODULES_CHARGER_MT6360=m   # 5.10: CONFIG_CHARGER_MT6360=m
CONFIG_DEVICE_MODULES_MEDIATEK_WATCHDOG=m   # 5.10: CONFIG_MEDIATEK_WATCHDOG=m
CONFIG_DEVICE_MODULES_MFD_MT6397=m   # 5.10: CONFIG_MFD_MT6397=m
CONFIG_DEVICE_MODULES_REGULATOR_MT6315=m   # 5.10: CONFIG_REGULATOR_MT6315=m
CONFIG_DEVICE_MODULES_REGULATOR_MTK_DVFSRC=m   # 5.10: CONFIG_REGULATOR_MTK_DVFSRC=m
CONFIG_DEVICE_MODULES_REGULATOR_RT6160=m   # 5.10: CONFIG_REGULATOR_RT6160=m
CONFIG_DEVICE_MODULES_DRM_MEDIATEK=m   # 5.10: CONFIG_DRM_MEDIATEK=m
CONFIG_DEVICE_MODULES_SND_SOC_MT6895=m   # 5.10: CONFIG_SND_SOC_MT6895=m
CONFIG_DEVICE_MODULES_SND_SOC_MT6895_MT6368=m   # 5.10: CONFIG_SND_SOC_MT6895_MT6368=m
CONFIG_DEVICE_MODULES_SND_SOC_MTK_BTCVSD=m   # 5.10: CONFIG_SND_SOC_MTK_BTCVSD=m
CONFIG_DEVICE_MODULES_USB_MTU3=m   # 5.10: CONFIG_USB_MTU3=m
CONFIG_DEVICE_MODULES_LEDS_MT6360=m   # 5.10: CONFIG_LEDS_MT6360=m
CONFIG_DEVICE_MODULES_RTC_DRV_MT6397=m   # 5.10: CONFIG_RTC_DRV_MT6397=m
CONFIG_DEVICE_MODULES_MTK_UART_APDMA=m   # 5.10: CONFIG_MTK_UART_APDMA=m
CONFIG_DEVICE_MODULES_MTK_IOMMU=m   # 5.10: CONFIG_MTK_IOMMU=m
CONFIG_DEVICE_MODULES_MTK_PMIC_WRAP=m   # 5.10: CONFIG_MTK_PMIC_WRAP=m
CONFIG_DEVICE_MODULES_MTK_SCPSYS=m   # 5.10: CONFIG_MTK_SCPSYS=m
CONFIG_DEVICE_MODULES_MEDIATEK_MT6577_AUXADC=m   # 5.10: CONFIG_MEDIATEK_MT6577_AUXADC=m
CONFIG_DEVICE_MODULES_PWM_MTK_DISP=m   # 5.10: CONFIG_PWM_MTK_DISP=m
# CONFIG_DEVICE_MODULES_RESET_TI_SYSCON is not set
CONFIG_DEVICE_MODULES_PHY_MTK_TPHY=m   # 5.10: CONFIG_PHY_MTK_TPHY=m
CONFIG_DEVICE_MODULES_PHY_MTK_XSPHY=m   # 5.10: CONFIG_PHY_MTK_XSPHY=m
CONFIG_DEVICE_MODULES_VIDEO_MEDIATEK_VCODEC=m   # 5.10: CONFIG_VIDEO_MEDIATEK_VCODEC=m
CONFIG_DEVICE_MODULES_VIDEO_MEDIATEK_JPEG=m   # 5.10: CONFIG_VIDEO_MEDIATEK_JPEG=m
CONFIG_DEVICE_MODULES_MTK_MMSYS=m   # 5.10: CONFIG_MTK_MMSYS=m
CONFIG_DEVICE_MODULES_MMC_MTK=m   # 5.10: CONFIG_MMC_MTK=m
CONFIG_DEVICE_MODULES_MMC_MTK_PRO=m   # 5.10: CONFIG_MMC_MTK_PRO=m
# CONFIG_DEVICE_MODULES_MMC_CQHCI is not set
CONFIG_DEVICE_MODULES_MMC_DEBUG=m   # 5.10: CONFIG_MMC_DEBUG=m
CONFIG_DEVICE_MODULES_MTK_CQDMA=m   # 5.10: CONFIG_MTK_CQDMA=m

# ---------------------------------------------------------------------------
# LTO / symbol versions. KERNEL_LTO := thin in kernel-plato-vars.mk makes
# vendor/lineage/build/tasks/kernel.mk drive CLANG_THIN *after* the fragments
# are merged, but that path is easy to lose (olddefconfig resets it to the
# Kconfig default LTO_NONE), and the two options are mutually exclusive:
# GENDWARFKSYMS has "depends on DEBUG_INFO && !LTO", so enabling thin LTO
# silently drops it to =y-with-no-tool and every module build then dies with
#     /bin/sh: ./scripts/gendwarfksyms/gendwarfksyms: No such file or directory
#     make[5]: *** [scripts/Makefile.build:246: ...] Error 127
# Pinning both here keeps the merged config self-consistent whichever path
# produced it.
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_GENDWARFKSYMS is not set
